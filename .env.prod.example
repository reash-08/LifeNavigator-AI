# ==============================================================================
# LifeNavigator-AI Production Environment Variables Template
# Copy this file to .env.prod before starting with:
# docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
# ==============================================================================

# --- Database Configuration ---
POSTGRES_DB=lifenavigator
POSTGRES_USER=lifenavigator
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here

# When using the bundled 'db' container in docker-compose.prod.yml:
DATABASE_URL=postgresql+psycopg://lifenavigator:generate_a_secure_random_db_password_here@db:5432/lifenavigator
# For externally managed PostgreSQL (e.g. AWS RDS, GCP Cloud SQL, Supabase):
# DATABASE_URL=postgresql+psycopg://username:password@your-managed-db.provider.com:5432/lifenavigator

# --- Security & JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never commit real keys.
JWT_SECRET_KEY=replace_with_a_secure_random_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_ISSUER=life-navigator-ai
JWT_AUDIENCE=life-navigator-ai-api

# --- Admin Bootstrap Allowlist ---
# Comma-separated emails granted administrative privileges upon registration
ADMIN_EMAILS=admin@example.com

# --- Environment & Network ---
ENVIRONMENT=production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost,http://127.0.0.1

# Optional Reverse Proxy IP allowlist (e.g. Cloudflare, Traefik, AWS ALB)
# When blank (default), direct client IP is used and X-Forwarded-For is ignored.
TRUSTED_PROXIES=

# --- Host Port Bindings ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Frontend Build Options ---
# Defaults to empty string (recommended) so the Nginx reverse-proxy handles /api calls relatively.
# If hosting frontend and backend on distinct hostnames:
# VITE_API_URL=https://api.yourdomain.com
VITE_API_URL=

# --- Rate Limiting (SlowAPI) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_AGENT=20/minute

# --- AI & RAG Configuration ---
LLM_PROVIDER=template
EMBEDDING_PROVIDER=deterministic
SYNC_INTERVAL_HOURS=24
RAG_SIMILARITY_THRESHOLD=0.1
HYBRID_ALPHA=0.6

# Optional Cloud API Keys (leave empty when using default deterministic template providers)
OPENAI_API_KEY=
GEMINI_API_KEY=
