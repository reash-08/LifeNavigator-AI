# LifeNavigator-AI Configuration Template
# PostgreSQL connection string for active environment:
# Example: postgresql+psycopg://username:password@localhost:5432/lifenavigator
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/lifenavigator

# JWT Security
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be at least 32 characters. Never commit real keys.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SCHEDULER_ENABLED=true
JWT_ISSUER=life-navigator-ai
JWT_AUDIENCE=life-navigator-ai-api

# Admin bootstrap allowlist (comma-separated emails granted admin role at registration)
ADMIN_EMAILS=admin@example.com

# RAG & Embeddings Configuration
# Options: deterministic (384-dim offline hashing embedding, zero-cost, default) or openai
EMBEDDING_PROVIDER=deterministic

# Grounded Explanation / LLM Configuration
# Options: template (deterministic grounded citations, zero-cost, default), openai, or gemini
LLM_PROVIDER=template

# Optional Cloud API Keys (leave empty or unset when using default zero-cost offline providers)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Automated Government Scheme Synchronization
# Polling interval in hours for background worker (default: 24 for daily synchronization)
SYNC_INTERVAL_HOURS=24

# Hybrid Retrieval Weights & Thresholds
RAG_SIMILARITY_THRESHOLD=0.1
HYBRID_ALPHA=0.6

# Deployment & Network Security
# Comma-separated list of permitted origin URLs for frontend clients (no wildcards with credentials)
ENVIRONMENT=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# API Abuse Protections & Rate Limiting (SlowAPI)
# Controls endpoint call limits per window. Format: "<count>/<minute|hour|day>"
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
RATE_LIMIT_AGENT=20/minute
RATE_LIMIT_ENABLED=true

# Reverse Proxy Security
# Comma-separated IPs/subnets of trusted reverse proxies (e.g. Nginx, Cloudflare, Traefik).
# When blank (default), direct client socket address is used and X-Forwarded-For is ignored.
TRUSTED_PROXIES=
